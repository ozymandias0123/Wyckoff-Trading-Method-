; Wyckoff Trading Bot - Conservative Settings
; Recommended for beginners and risk-averse traders
; Use on H1 or H4 timeframes with major forex pairs

; General Settings
MagicNumber=123456
TradeComment=Wyckoff Conservative

; Risk Management - Conservative
RiskPercent=0.5
MaxLotSize=1.0
MinLotSize=0.01
MaxSpread=30

; Wyckoff Parameters - Strict Requirements
AccumulationBars=70
VolumePeriod=20
VolumeThreshold=1.8
TrendPeriod=60
TradeAccumulation=true
TradeDistribution=false

; Exit Settings - Wider Targets
TakeProfitMultiplier=2.5
StopLossMultiplier=1.0
ATRPeriod=14
UseTrailingStop=true
TrailingStopMultiplier=1.5
